--- !u!114 &1417813917
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1417813915}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 30bf14e19a4a12a4a9b527f3ec62ef50, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrationSource: {fileID: 1417813916}
  distantVolumeFactor: 0.5
  distantSpatialBlend: 1
  normalSpatialBlend: 0
  subtitleText: {fileID: 79763480}
  subtitleBackgroundGroup: {fileID: 514653594}
  backgroundFadeDuration: 0.5
  extraText: {fileID: 1776903440}
  subtitles:
  - clip: {fileID: 8300000, guid: 243ab42739d77d943a00245099cd099d, type: 3}
    subtitle: "Rena:\nVen\xED, acompa\xF1ame a la playa. Hay una caja registradora
      en la arena, no tiene L\xD3GICA. En la tienda hay un plato de medialunas horrendo
      y sobre el mantel del picnic hay un castillo de arena. Cualquiera, encima yo
      tengo el toc del orden. \xBFQu\xE9 es este lugar?"
  - clip: {fileID: 8300000, guid: a865b72468eefc249a9fdf0427b8a3d1, type: 3}
    subtitle: "Rena:\n\xA1Ahhh, lo podes agarrar! \xA1Ya s\xE9! \xBFY si llevas cada
      objeto al lugar donde deber\xEDa ir? Tipo, la caja registradora a la tienda,
      las medialunas al picnic y el castillo de arena a la playa."
  - clip: {fileID: 8300000, guid: d962b6a074ef4de4d8a353eb66e6b19a, type: 3}
    subtitle: "Rena:\nNunca vi tanta desincronizaci\xF3n en un lugar, me da escalofr\xEDos."
  - clip: {fileID: 8300000, guid: 8a3591742c4c9f44e938af355bf42d41, type: 3}
    subtitle: "Rena:\n\xA1Vamos que queda un solo objeto!"
  - clip: {fileID: 8300000, guid: 4a7d4827cc9ceaa45a672bbc2f72302a, type: 3}
    subtitle: "Rena:\n\xA1No lo puedo creer! Volvi\xF3 todo a la normalidad. \xA1Este
      lugar se sincronizo!"
  - clip: {fileID: 8300000, guid: fb4aa8dc91d5ae44cafb79200e62ca5e, type: 3}
    subtitle: "Rena:\nMmm... Me parece que ac\xE1 no va."
  - clip: {fileID: 8300000, guid: 4fe9d9e21dd184c408011af7e96a4479, type: 3}
    subtitle: "Rena:\n\xBFY vos quien sos? Bueno no importa. Necesito tu ayuda. Estaba
      en contrapunto discutiendo con las chicas sobre la forma de una idea, \xA1y
      de repente aparec\xEDa ac\xE1! Estoy intentando ver que onda este lugar \xA1pero
      no entiendo porque las cosas est\xE1n as\xED!, como DEFORMES. Ayudame, estoy
      completamente perdida."
  - clip: {fileID: 8300000, guid: 033d8f9fbe382524983d112be1edcb55, type: 3}
    subtitle: "Rena:\nEso brillante me suena conocido... \xBFEs la s\xEDntesis de
      contrapunto? \xBFQu\xE9 pasa si lo toc\xE1s?"
  repeatEnabled: 1
